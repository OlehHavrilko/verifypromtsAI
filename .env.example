# ── Client (build-time, public) ───────────────────────────────────────────────
# Your own Supabase project: Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_anon_key

# Optional: canonical site URL for SEO tags (defaults to the current origin)
VITE_SITE_URL=https://your-domain.example

# Optional: base path when hosting under a subdirectory (GitHub Pages sets it
# automatically inside the deploy workflow). Leave empty for a root domain.
# VITE_BASE_PATH=/verifypromtsAI/

# ── Stripe (optional, public price/product IDs) ───────────────────────────────
VITE_STRIPE_PRODUCT_PRO=
VITE_STRIPE_PRICE_PRO=
VITE_STRIPE_PRODUCT_BUSINESS=
VITE_STRIPE_PRICE_BUSINESS=

# ── Server-side secrets (Supabase edge functions, NOT in the frontend) ───────
# Set with: supabase secrets set AI_API_KEY=... --project-ref <ref>
# AI_API_KEY=sk-...                      # DeepSeek API key
# AI_BASE_URL=https://api.deepseek.com/v1
# AI_MODEL=deepseek-chat                 # or deepseek-reasoner
# AI_PROVIDER=deepseek
# AI_JUDGE_MODEL=deepseek-chat
# Vision (DeepSeek has no vision model — point at another OpenAI-compatible API)
# AI_VISION_MODEL=gpt-4o-mini
# AI_VISION_BASE_URL=https://api.openai.com/v1
# AI_VISION_API_KEY=sk-...
# APP_SITE_URL=https://your-domain.example
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PRODUCT_PRO=prod_...
# STRIPE_PRODUCT_BUSINESS=prod_...
